{
  "name": "@hanui/vue-components",
  "version": "0.2.0",
  "description": "KRDS HTML ComponentKit 리소스를 그대로 사용하는 공공 웹사이트용 Vue 컴포넌트 라이브러리",
  "keywords": [
    "vue",
    "components",
    "ui",
    "krds",
    "korea",
    "design-system",
    "government",
    "public",
    "accessibility",
    "a11y",
    "hanui"
  ],
  "homepage": "https://hanui.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanui-o/hanui.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/hanui-o/hanui/issues"
  },
  "author": "hanui-o",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/vue.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.11.0",
    "eslint-plugin-vue": "^10.6.2",
    "jsdom": "^27.2.0",
    "sass-embedded": "^1.83.0",
    "storybook": "^10.6.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.14",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.0"
  }
}
