{
  "name": "@hanui/react",
  "version": "1.0.0",
  "description": "KRDS 기반 공공 웹사이트용 React 컴포넌트 라이브러리 - Korean Government Design System (KRDS) based React component library for public web services",
  "keywords": [
    "react",
    "react-components",
    "components",
    "ui",
    "ui-library",
    "krds",
    "korea",
    "korean",
    "design-system",
    "design-tokens",
    "government",
    "public",
    "accessibility",
    "a11y",
    "wcag",
    "hanui",
    "tailwindcss",
    "tailwind",
    "radix-ui",
    "radix",
    "typescript",
    "shadcn",
    "shadcn-ui",
    "copy-paste",
    "nextjs",
    "next"
  ],
  "homepage": "https://hanui.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanui-o/hanui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/hanui-o/hanui/issues"
  },
  "author": "hanui-o",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.mjs",
      "require": "./dist/charts.js"
    },
    "./kits/authentication": {
      "types": "./dist/kits/authentication/index.d.ts",
      "import": "./dist/kits/authentication/index.mjs",
      "require": "./dist/kits/authentication/index.js"
    },
    "./kits/dashboard": {
      "types": "./dist/kits/dashboard/index.d.ts",
      "import": "./dist/kits/dashboard/index.mjs",
      "require": "./dist/kits/dashboard/index.js"
    },
    "./kits/form": {
      "types": "./dist/kits/form/index.d.ts",
      "import": "./dist/kits/form/index.mjs",
      "require": "./dist/kits/form/index.js"
    },
    "./kits/settings": {
      "types": "./dist/kits/settings/index.d.ts",
      "import": "./dist/kits/settings/index.mjs",
      "require": "./dist/kits/settings/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./react.css": "./src/styles.css",
    "./variables.css": "./src/variables.css",
    "./tailwind.preset": "./tailwind.preset.ts"
  },
  "files": [
    "dist",
    "src/styles.css",
    "src/variables.css",
    "tailwind.preset.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint src --ext .ts,.tsx --ignore-pattern 'src/kits/board/**'",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
