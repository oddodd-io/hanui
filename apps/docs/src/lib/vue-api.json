  "button": {
    "component": "Button",
    "install": "button",
    "description": "Button — KRDS `.krds-btn` 래퍼",
    "props": [
      {
        "name": "variant",
        "type": "'primary' | 'secondary' | 'tertiary' | 'text' | 'link'",
        "required": false,
        "description": "KRDS 계층. 기본 primary",
        "default": "'primary'"
      },
      {
        "name": "size",
        "type": "'xsmall' | 'small' | 'medium' | 'large' | 'xlarge'",
        "required": false,
        "description": "KRDS 크기. 기본 large (KRDS 기본값)",
        "default": "'large'"
      },
      {
        "name": "icon",
        "type": "boolean",
        "required": false,
        "description": "아이콘 전용 버튼 (`.icon`). `label`로 접근성 이름을 반드시 제공한다",
        "default": "false"
      },
      {
        "name": "border",
        "type": "boolean",
        "required": false,
        "description": "아이콘 전용 버튼의 테두리형 (`.icon.border`)",
        "default": "false"
      },
      {
        "name": "label",
        "type": "string",
        "required": false,
        "description": "아이콘 전용 버튼의 접근성 이름. `sr-only`로 렌더된다",
        "default": null
      },
      {
        "name": "pure",
        "type": "boolean",
        "required": false,
        "description": "link 계층: hover/visited 색 변화 없음 (`.pure`)",
        "default": "false"
      },
      {
        "name": "basic",
        "type": "boolean",
        "required": false,
        "description": "link 계층: 본문 텍스트 색 (`.basic`)",
        "default": "false"
      },
      {
        "name": "disabled",
        "type": "boolean",
        "required": false,
        "description": "비활성. `<button>`은 native disabled, `<a>`는 href 제거 + aria-disabled",
        "default": "false"
      },
      {
        "name": "type",
        "type": "'button' | 'submit' | 'reset'",
        "required": false,
        "description": "`<button>` type. 기본 button (폼 안 submit 오작동 방지)",
        "default": "'button'"
      },
      {
        "name": "href",
        "type": "string",
        "required": false,
        "description": "지정 시 `<a>`로 렌더",
        "default": null
      },
      {
        "name": "target",
        "type": "string",
        "required": false,
        "description": "",
        "default": null
      },
      {
        "name": "rel",
        "type": "string",
        "required": false,
        "description": "",
        "default": null
      }
    ],
    "emits": [
      {
        "name": "click",
        "payload": "event: MouseEvent",
        "description": ""
      }
    ],
    "slots": ["default"]
  },
