{
  "badge": {
    "component": "Badge",
    "install": "badge",
    "description": "Badge — KRDS `span.krds-badge` 래퍼",
    "props": [
      {
        "name": "variant",
        "type": "'outline' | 'bg' | 'bg-light'",
        "required": false,
        "description": "outline: 테두리 / bg: 진한 배경 / bg-light: 연한 배경",
        "default": "'bg'"
      },
      {
        "name": "color",
        "type": "'primary' | 'secondary' | 'gray' | 'point' | 'danger' | 'warning' | 'success' | 'information' | 'disabled'",
        "required": false,
        "description": "",
        "default": "'primary'"
      },
      {
        "name": "size",
        "type": "'small' | 'medium' | 'large'",
        "required": false,
        "description": "KRDS CSS는 large만 크기를 바꾼다. small·medium은 원본 예제처럼 클래스만 붙는다",
        "default": null
      },
      {
        "name": "count",
        "type": "number",
        "required": false,
        "description": "숫자형 배지(`.number`). 주면 슬롯 대신 숫자를 표시한다",
        "default": null
      },
      {
        "name": "max",
        "type": "number",
        "required": false,
        "description": "count가 이 값을 넘으면 \"{max}+\"로 표시한다",
        "default": "999"
      },
      {
        "name": "dot",
        "type": "boolean",
        "required": false,
        "description": "점형 배지(`.dot`). 내용이 없으므로 label이 필요하다",
        "default": "false"
      },
      {
        "name": "label",
        "type": "string",
        "required": false,
        "description": "스크린리더용 설명 (sr-only). 예: count와 함께 \"읽지 않은 알림\", dot과 함께 \"새 글\"",
        "default": null
      }
    ],
    "emits": [],
    "slots": ["default"]
  },
